# X Power Program - Environment Configuration
# Local SQLite runs automatically out-of-the-box in /data/xpower.db

# JWT & Session Security
SESSION_SECRET=xpower-program-production-super-secret-key-kenya-2026-secure-jwt

# Application Settings
NEXT_PUBLIC_APP_NAME="X Power Program"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Production PostgreSQL / Supabase Configuration
# When connecting to Supabase or Managed PostgreSQL in production:
# DATABASE_URL="postgresql://postgres:your_password@db.supabase.co:5432/postgres"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
