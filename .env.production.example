# ==============================================================================
# X POWER PROGRAM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production or set these environment variables
# in your production hosting platform (Vercel, Railway, Render, Fly.io, VPS, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMAIN & APPLICATION SETTINGS (REQUIRED)
# ------------------------------------------------------------------------------
# Set this to your exact live custom domain with https:// (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_NAME="X Power Program"

# Demo Sandbox Banner & Auto-login:
# Set to "false" in real production so demo test banners & demo login routes are disabled.
# Set to "true" only if you want an open staging/demo environment.
NEXT_PUBLIC_ENABLE_DEMO_SANDBOX="false"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS (REQUIRED)
# ------------------------------------------------------------------------------
# Generate a cryptographically random 64-character secret string.
# On Linux/macOS/Git Bash: openssl rand -base64 48
# On PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET="your-strong-production-random-secret-key-at-least-32-chars-long"

# Standard Node environment
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (OPTIONAL / PRODUCTION SCALE)
# ------------------------------------------------------------------------------
# OUT-OF-THE-BOX:
# If left empty, X Power uses high-performance persistent SQLite at ./data/xpower.db
# (Supported on VPS, Docker, Railway Persistent Volume, Render Disk).
#
# WHEN MIGRATING TO MANAGED POSTGRESQL / SUPABASE / NEON:
# Execute the included schema.sql in your PostgreSQL database, then provide:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-supabase-or-neon.co:5432/postgres?sslmode=require"
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 4. S3 / OBJECT STORAGE (OPTIONAL FOR RESUMES & LOGOS)
# ------------------------------------------------------------------------------
# Default uploads are saved to public/uploads.
# For serverless platforms (e.g., Vercel without persistent disks), use S3 or Cloudflare R2:
# S3_BUCKET_NAME="xpower-documents-prod"
# S3_REGION="af-south-1"
# S3_ACCESS_KEY_ID="your_s3_key"
# S3_SECRET_ACCESS_KEY="your_s3_secret"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & SMS (OPTIONAL)
# ------------------------------------------------------------------------------
# RESEND_API_KEY="re_123456789"
# AFRICASTALKING_USERNAME="xpower"
# AFRICASTALKING_API_KEY="your_africastalking_key"
